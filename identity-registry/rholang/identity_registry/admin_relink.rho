new ret, lookup(`rho:registry:lookup`), registryCh in {
  lookup!(`{{uri}}`, *registryCh) |
  for (@(_, registry) <- registryCh) {
    @[registry, "admin_relink"]!(
      "{{name_hex}}".hexToBytes(),
      "{{new_pk_hex}}".hexToBytes(),
      {{seq}},
      "{{admin_evidence_hex}}".hexToBytes(),
      {{admin_sigs}},
      "{{new_sig_hex}}".hexToBytes(),
      *ret
    ) |
    for (@replyProc <- ret) {
      @"{{reply_slot}}"!(replyProc)
    }
  }
}
