// Identity Registry, deployed at genesis and registered at
// `rho:system:identityRegistry`.

// Per-operation payloads. For each operation the Rust client and this
// contract construct the same payload bytes from a shared set of structured
// args. The client signs the digest locally, and the contract rebuilds the
// payload from the args it receives on the wire and verifies the signature
// against the digest.
//
//   register:     0x01 || pk(65)   || nonce(32)                     == 98 bytes
//   rotate:       0x02 || name(32) || new_pk(65) || seq.toByteArray()
//   admin_relink: 0x03 || name(32) || new_pk(65) || seq.toByteArray() || admin_evidence
//
// name = blake2b256(payload_register)
// Every operation's `sig` is a secp256k1 signature over blake2b256(payload).

new
  identityRegistry,
  rs(`rho:registry:insertSigned:secp256k1`),
  uriOut,
  secpVerify(`rho:crypto:secp256k1Verify`),
  blake2b256(`rho:crypto:blake2b256Hash`),
  lookup(`rho:registry:lookup`)
in {
  // The raw name is published, not a bundle: callers address the contracts
  // as @[*registry, "<op>"], which only matches the unbundled name.
  rs!(
    "04b5e7d2c17c8a08b1c5983cd6def4124faa345698eada20c91f0a47406f8827c9cdb80f2e514b4b03b2d3a73501c500f675c756867dcbf9fcad57fa7412acb22e".hexToBytes(),
    (9223372036854775807, *identityRegistry),
    "3045022100cb64110905f0634967f9f6e3e20eb998b86dffd21121dd94848bc2f2355ca29202206fce173639fdf67d1fbcb0d6c06154193d9d4bf1b3c8ca857f18f2be05c27863".hexToBytes(),
    *uriOut
  )
  |

  new identities, adminPk, registerLock in {
    // REG-D3: the admin key comes from the genesis config
    // (`identity-registry-admin-public-key`). Baked in once and never
    // changes in the prototype.
    //
    // TODO: Update to a multi-signer admin (quorum). The spec stubs this as a
    // single admin key for the prototype (D32). Swapping it out should only
    // change the signer set in admin_relink's sig check.
    adminPk!("$$identityRegistryAdminPublicKey$$".hexToBytes()) |

    // Initial token for the register lock. See the fresh-leaf race TODO
    // below for why this exists.
    registerLock!(Nil) |

    // The identity store. Keyed by name (32-byte ByteArray, == blake2b256(payload_register)).
    // Record shape:
    //   { "current": ByteArray(65),
    //     "history": [{ "pk": ByteArray(65), "op": String, "seq": Int, "admin_evidence"?: ByteArray }, ...],
    //     "seq":     Int
    //   }
    //
    // Backed by the system TreeHashMap. depth = 3 gives 24 bits of key-path
    // parallelization. Writes to distinct names commute via BitmaskOr on
    // interior-node bitmaps, so concurrent register / rotate / admin_relink
    // calls targeting different identities no longer serialize through one
    // channel. identities holds the pair (TreeHashMap system contract, map
    // handle) persistently, so every contract peeks it.
    //
    // FIXME: Fresh-leaf race. The TreeHashMap merger catches concurrent writes
    // to an existing leaf through the standard RSpace consume rule on the
    // leaf map, but two blocks that both create the same leaf for the first
    // time can leave two Maps on the leaf channel. Mitigated for now by
    // serializing register through a global registerLock. Remove once the
    // merger catches this case.
    new treeHashMapCh in {
      lookup!(`rho:lang:treeHashMap`, *treeHashMapCh) |
      for (treeHashMap <- treeHashMapCh) {
        new identitiesHandleCh in {
          treeHashMap!("init", 3, *identitiesHandleCh) |
          for (@identitiesHandle <- identitiesHandleCh) {
            identities!!((*treeHashMap, identitiesHandle))
          }
        }
      }
    } |

    // register(pk, nonce, sig, ret)
    //
    // payload = 0x01 || pk(65) || nonce(32) - built by the contract from the args.
    // sig     = secp256k1 signature over blake2b256(payload), under pk.
    //
    // The 32-byte client-supplied nonce decouples the name from the pk so
    // that the same key can back more than one identity under different
    // nonces. Replay of a captured (pk, nonce, sig) still collapses to an
    // idempotent no-op because the name is derived from the full payload
    // (REG-AC6).
    //
    // Responses:
    //   ("err", "bad_signature") when the signature does not verify under pk.
    //   ("ok", name) on fresh mint, or as an idempotent no-op when the name
    //   already exists (REG-AC6).
    contract @[*identityRegistry, "register"](@pk, @nonce, @sig, ret) = {
      new hashCh, verifyCh in {
        blake2b256!(
          "01".hexToBytes() ++ pk ++ nonce,
          *hashCh
        ) |
        for (@hash <- hashCh) {
          secpVerify!(hash, sig, pk, *verifyCh) |
          for (@valid <- verifyCh) {
            if (valid) {
              for (_ <- registerLock) {
                for (@(treeHashMap, identitiesHandle) <<- identities) {
                  new existsCh in {
                    @treeHashMap!("contains", identitiesHandle, hash, *existsCh) |
                    for (@exists <- existsCh) {
                      if (exists) {
                        registerLock!(Nil) |
                        ret!(("ok", hash))
                      } else {
                        new ackCh in {
                          @treeHashMap!("set", identitiesHandle, hash, {
                            "current": pk,
                            "history": [{"pk": pk, "op": "register", "seq": 0}],
                            "seq": 0
                          }, *ackCh) |
                          for (_ <- ackCh) {
                            registerLock!(Nil) |
                            ret!(("ok", hash))
                          }
                        }
                      }
                    }
                  }
                }
              }
            } else {
              ret!(("err", "bad_signature"))
            }
          }
        }
      }
    }
    |

    // rotate(name, newPk, seq, sig, newSig, ret)
    //
    // payload = 0x02 || name(32) || new_pk(65) || seq.toByteArray()
    // sig     = secp256k1 signature over blake2b256(payload), by the
    //           identity's current key.
    // newSig  = secp256k1 signature over the same hash, by the new key.
    //           Proves the submitter holds newPk, so an attacker cannot
    //           rotate an identity onto a key they do not control.
    //
    // The contract builds `payload` itself from the args, so the client and
    // the contract never disagree on canonical bytes.
    //
    // Responses:
    //   ("err", "unknown_name") when `name` is not registered.
    //   ("err", "seq_mismatch") when `seq` does not match the record's current
    //   seq.
    //   ("err", "bad_signature") when either signature does not verify.
    //   ("ok", newSeq) on success, where newSeq = seq + 1. The record's
    //   current key becomes newPk, the previous key stays in history, and
    //   seq is bumped (REG-AC4, REG-AC5).
    contract @[*identityRegistry, "rotate"](@name, @newPk, @seq, @sig, @newSig, ret) = {
      for (@(treeHashMap, identitiesHandle) <<- identities) {
        new existingCh in {
          @treeHashMap!("get", identitiesHandle, name, *existingCh) |
          for (@existing <- existingCh) {
            match existing {
              Nil => ret!(("err", "unknown_name"))
              rec => {
                if (seq != rec.get("seq")) {
                  ret!(("err", "seq_mismatch"))
                } else {
                  new hashCh, verifyCh, verifyNewCh in {
                    blake2b256!(
                      "02".hexToBytes() ++ name ++ newPk ++ seq.toByteArray(),
                      *hashCh
                    ) |
                    for (@hash <- hashCh) {
                      secpVerify!(hash, sig, rec.get("current"), *verifyCh) |
                      secpVerify!(hash, newSig, newPk, *verifyNewCh) |
                      for (@valid <- verifyCh & @validNew <- verifyNewCh) {
                        match (valid, validNew) {
                          (true, true) => {
                            new ackCh in {
                              @treeHashMap!("set", identitiesHandle, name, {
                                "current": newPk,
                                "history": rec.get("history") ++
                                  [{"pk": newPk, "op": "rotate", "seq": seq + 1}],
                                "seq": seq + 1
                              }, *ackCh) |
                              for (_ <- ackCh) {
                                ret!(("ok", seq + 1))
                              }
                            }
                          }
                          _ => ret!(("err", "bad_signature"))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    |

    // admin_relink(name, newPk, seq, adminEvidence, sig, newSig, ret)
    //
    // The compromised-key path (REG-D3, REG-AC9). Signed by the registry's
    // admin pk (baked in at deploy time) and also by the new key, so an
    // admin cannot relink an identity onto a key the operator does not
    // control. adminEvidence is recorded verbatim in history and never
    // validated.
    //
    // payload = 0x03 || name(32) || new_pk(65) || seq.toByteArray() || adminEvidence
    // sig     = secp256k1 signature over blake2b256(payload), by the admin pk.
    // newSig  = secp256k1 signature over the same hash, by the new key.
    //
    // Responses:
    //   ("err", "unknown_name") when `name` is not registered.
    //   ("err", "seq_mismatch") when `seq` does not match the record's current
    //   seq.
    //   ("err", "bad_signature") when either signature does not verify.
    //   ("ok", newSeq) on success, where newSeq = seq + 1. The record's
    //   current key becomes newPk, the history grows by one entry carrying
    //   the adminEvidence, and seq is bumped.
    contract @[*identityRegistry, "admin_relink"]
      (@name, @newPk, @seq, @adminEvidence, @sig, @newSig, ret) = {
      for (@adminPkVal <<- adminPk) {
        for (@(treeHashMap, identitiesHandle) <<- identities) {
          new existingCh in {
            @treeHashMap!("get", identitiesHandle, name, *existingCh) |
            for (@existing <- existingCh) {
              match existing {
                Nil => ret!(("err", "unknown_name"))
                rec => {
                  if (seq != rec.get("seq")) {
                    ret!(("err", "seq_mismatch"))
                  } else {
                    new hashCh, verifyCh, verifyNewCh in {
                      blake2b256!(
                        "03".hexToBytes() ++
                          name ++
                          newPk ++
                          seq.toByteArray() ++
                          adminEvidence,
                        *hashCh
                      ) |
                      for (@hash <- hashCh) {
                        secpVerify!(hash, sig, adminPkVal, *verifyCh) |
                        secpVerify!(hash, newSig, newPk, *verifyNewCh) |
                        for (@valid <- verifyCh & @validNew <- verifyNewCh) {
                          match (valid, validNew) {
                            (true, true) => {
                              new ackCh in {
                                @treeHashMap!("set", identitiesHandle, name, {
                                  "current": newPk,
                                  "history": rec.get("history") ++
                                    [{"pk": newPk, "op": "admin_relink", "seq": seq + 1,
                                      "admin_evidence": adminEvidence}],
                                  "seq": seq + 1
                                }, *ackCh) |
                                for (_ <- ackCh) {
                                  ret!(("ok", seq + 1))
                                }
                              }
                            }
                            _ => ret!(("err", "bad_signature"))
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    |

    // resolve_current(name, ret)
    //
    // Returns the key currently authorised to sign for this identity plus
    // its sequence number (bundled because a caller building a rotate payload
    // needs both).
    //
    // Responses:
    //   ("err", "unknown_name")
    //   ("ok", {"pk": ByteArray(65), "seq": Int})
    contract @[*identityRegistry, "resolve_current"](@name, ret) = {
      for (@(treeHashMap, identitiesHandle) <<- identities) {
        new existingCh in {
          @treeHashMap!("get", identitiesHandle, name, *existingCh) |
          for (@existing <- existingCh) {
            match existing {
              Nil => ret!(("err", "unknown_name"))
              rec => ret!(("ok", {"pk": rec.get("current"), "seq": rec.get("seq")}))
            }
          }
        }
      }
    }
    |

    // resolve_history(name, ret)
    //
    // Returns the full append-only history for this identity. Needed for
    // attributing claims signed under previously-current keys (REG-AC8).
    //
    // Responses:
    //   ("err", "unknown_name")
    //   ("ok", [{"pk", "op", "seq", "admin_evidence"?}, ...])
    contract @[*identityRegistry, "resolve_history"](@name, ret) = {
      for (@(treeHashMap, identitiesHandle) <<- identities) {
        new existingCh in {
          @treeHashMap!("get", identitiesHandle, name, *existingCh) |
          for (@existing <- existingCh) {
            match existing {
              Nil => ret!(("err", "unknown_name"))
              rec => ret!(("ok", rec.get("history")))
            }
          }
        }
      }
    }
  }
}
